#!/usr/bin/env php
<?php
// @codingStandardsIgnoreStart
define('CFCLI', true);

/**
 * Mencari docroot CF dengan menelusuri direktori ke atas sampai menemukan
 * berkas penanda `cf`.
 *
 * Menelusuri dengan realpath tiap langkah dan berhenti di akar sistem berkas.
 * Sebelumnya ia memanggil dirinya sendiri dengan menambahkan '/..' ke akhir
 * path tanpa pernah menormalkannya, sehingga path-nya terus memanjang -
 * '/a/b/../../..' dan seterusnya - dan pemberhentiannya hanya terjadi ketika
 * panjangnya melewati batas sistem berkas. Terukur 1.330 panggilan sebelum
 * menyerah untuk satu direktori biasa.
 *
 * @param string $path
 *
 * @return null|string
 */
function __findCFPath($path) {
    $current = realpath($path);
    if ($current === false) {
        return null;
    }

    while (true) {
        if (file_exists($current . DIRECTORY_SEPARATOR . 'cf')) {
            return $current;
        }

        $parent = realpath($current . DIRECTORY_SEPARATOR . '..');
        // akar sistem berkas: induknya dirinya sendiri
        if ($parent === false || $parent === $current) {
            return null;
        }

        $current = $parent;
    }
}

/**
 * Kode aplikasi dari posisi direktori kerja relatif terhadap docroot.
 *
 * @param null|string $cfPath
 *
 * @return null|string
 */
function __findCFAppCode($cfPath) {
    if ($cfPath === null) {
        return null;
    }

    $relativePath = trim(str_replace($cfPath, '', getcwd()), DIRECTORY_SEPARATOR);
    $relativePathExploded = explode(DIRECTORY_SEPARATOR, $relativePath);
    if (count($relativePathExploded) >= 2 && $relativePathExploded[0] == 'application') {
        return $relativePathExploded[1];
    }

    return null;
}

/**
 * @param string $message
 *
 * @return void
 */
function __cfCliFail($message) {
    fwrite(STDERR, $message . PHP_EOL);
    fwrite(STDERR, 'phpcf must run inside a CF docroot, or an app directory below it.' . PHP_EOL);
    fwrite(STDERR, "example: cd DOCROOT/application/cresenity/ && phpcf list" . PHP_EOL);

    exit(1);
}

$cwdPath = getcwd();
$cfPath = __findCFPath($cwdPath);

// Tanpa docroot tidak ada yang dapat di-bootstrap. Sebelumnya keadaan ini
// diteruskan begitu saja ke require, sehingga pesannya berupa fatal error
// tentang '/system/core/Bootstrap.php' - menunjuk berkas yang memang tidak
// pernah ada di akar sistem berkas, dan menyembunyikan sebab sebenarnya.
if ($cfPath === null) {
    __cfCliFail('CF docroot not found from ' . $cwdPath . ' (no `cf` marker file in any parent directory).');
}

$appCode = __findCFAppCode($cfPath);

if ($appCode != null) {
    define('CFCLI_APPCODE', $appCode);
    $appPath = $cfPath . DIRECTORY_SEPARATOR . 'application' . DIRECTORY_SEPARATOR . $appCode;
    if (file_exists($appPath . DIRECTORY_SEPARATOR . 'default' . DIRECTORY_SEPARATOR . 'public' . DIRECTORY_SEPARATOR . 'index.php')) {
        define('CFINDEX', $appPath . DIRECTORY_SEPARATOR . 'default' . DIRECTORY_SEPARATOR . 'public' . DIRECTORY_SEPARATOR . 'index.php');
    }
} else {
    // Di dalam docroot tetapi di luar direktori aplikasi: hanya perintah cf:*
    // yang bermakna, sebab perintah lain menuntut satu aplikasi.
    //
    // Syaratnya semula `count($argv) < 2 && substr($argv[1], 0, 3) != 'cf:'`,
    // dan itu keliru dua kali: dengan DAN, sebuah perintah yang membawa
    // argumen membuat ruas pertama salah sehingga penjaganya tidak pernah
    // berbunyi - `phpcf --version` lolos lalu fatal di require. Sedangkan
    // tanpa argumen sama sekali, $argv[1] yang dibaca ruas kedua tidak ada.
    $command = isset($argv[1]) ? $argv[1] : '';

    // Perintah bawaan console - `list`, `help`, `--version` - tidak menyentuh
    // aplikasi mana pun, jadi tetap boleh dari docroot. Sebelumnya ini bekerja
    // hanya karena penjaganya bocor, bukan karena disengaja; di sini
    // disengajakan supaya tidak ikut hilang saat kebocorannya ditutup.
    $consoleCommand = ['list', 'help', 'completion', '_complete'];
    // Perintah kerangka kerja yang dari docroot menyasar system/ itu sendiri
    // (`phpcf test` = tests/ framework, `phpcf phpstan <path>`), bukan
    // aplikasi tertentu.
    $frameworkCommand = ['test', 'phpstan', 'phpcs'];
    // Namespace lain yang juga hidup di system/libraries/CConsole/Command,
    // bukan di application/*, sehingga tak menuntut satu app tertentu -
    // sama seperti cf:*.
    $globalNamespaces = ['cf:', 'devcloud:', 'devsuite:', 'claude:', 'app:'];
    $isGlobalOption = $command !== '' && substr($command, 0, 1) === '-';
    $isConsoleCommand = in_array($command, $consoleCommand, true) || in_array($command, $frameworkCommand, true);
    $isGlobalNamespace = false;
    foreach ($globalNamespaces as $namespace) {
        if (substr($command, 0, strlen($namespace)) === $namespace) {
            $isGlobalNamespace = true;

            break;
        }
    }

    if (!$isGlobalNamespace && !$isGlobalOption && !$isConsoleCommand) {
        __cfCliFail(
            $command === ''
                ? 'No command given, and the current directory is not a CF app directory.'
                : 'Command `' . $command . '` needs an app directory; from the docroot only test, phpstan, phpcs, cf:*, devcloud:*, devsuite:*, claude:*, and app:* commands run.'
        );
    }
}

require $cfPath . DIRECTORY_SEPARATOR . 'system/core/Bootstrap.php';
